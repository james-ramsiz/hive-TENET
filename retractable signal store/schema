-- ═══════════════════════════════════════════════════════════════
-- 1. EVENT LOG — Append only. This is the source of truth.
--    No UPDATE, no DELETE, no TRUNCATE. Ever.
-- ═══════════════════════════════════════════════════════════════

CREATE TABLE signal_events (
    -- Logical identity. Not a sequence — generated by the producing service
    -- using a combination of timestamp + producer ID + local counter.
    event_id         TEXT NOT NULL PRIMARY KEY,
    
    -- The signal this event refers to.
    -- For emissions: this is the signal being created.
    -- For retractions: this is the signal being retracted.
    signal_id        TEXT NOT NULL,
    
    -- What kind of event is this?
    event_type       TEXT NOT NULL CHECK (event_type IN ('emission', 'retraction')),
    
    -- The worker and job type this signal is about.
    worker_id        TEXT NOT NULL,
    job_type_id      TEXT NOT NULL,
    
    -- The payload of the signal.
    -- For emissions: the actual signal data (outcome, rejection reasons, etc.)
    -- For retractions: the reason for retraction (overturn reason, etc.)
    event_payload    JSONB NOT NULL,
    
    -- Logical timestamp. Assigned by the event log service, NOT by the producer.
    -- This is a monotonically increasing sequence number that establishes
    -- total ordering of events. Wall clocks are unreliable across services.
    log_sequence     BIGINT NOT NULL,
    
    -- Wall clock time of when the event was received by the log service.
    -- Used for debugging, NOT for ordering or correctness.
    received_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    
    -- The producing service and the original request ID for tracing.
    producer_id      TEXT NOT NULL,
    original_request_id TEXT
);

-- Critical: the log_sequence must be unique and monotonically increasing.
-- We use a sequence, not a UUID or timestamp, because we need TOTAL ORDER.
CREATE SEQUENCE signal_event_log_seq START WITH 1 INCREMENT BY 1;
CREATE UNIQUE INDEX idx_signal_events_log_seq ON signal_events (log_sequence);

-- Index for the materialization query: get all events for a signal, in order
CREATE INDEX idx_signal_events_by_signal ON signal_events (signal_id, log_sequence);

-- Index for reconciliation: find all events for a worker/job_type
CREATE INDEX idx_signal_events_by_worker_job ON signal_events (worker_id, job_type_id, log_sequence);


-- ═══════════════════════════════════════════════════════════════
-- 2. MATERIALIZED VIEW — Derived from the event log.
--    This is what the feature store reads from.
--    It can be wrong temporarily, but the reconciliation job fixes it.
-- ═══════════════════════════════════════════════════════════════

CREATE TABLE signal_current_state (
    signal_id        TEXT NOT NULL PRIMARY KEY,
    
    -- Current status: 'active' or 'retracted'
    status           TEXT NOT NULL CHECK (status IN ('active', 'retracted')),
    
    -- The worker and job type (denormalized for fast feature store queries)
    worker_id        TEXT NOT NULL,
    job_type_id      TEXT NOT NULL,
    
    -- The emission payload (always the original — never modified)
    emission_payload JSONB NOT NULL,
    
    -- If retracted: the retraction payload
    retraction_payload JSONB,
    
    -- Log sequence numbers for the last emission and last retraction.
    -- Used by reconciliation to detect drift.
    last_emission_seq   BIGINT,
    last_retraction_seq BIGINT,
    
    -- Denormalized aggregate fields for fast feature store queries.
    -- These are what the deck ranking model actually reads.
    -- Computed during materialization, not stored in the event log.
    total_active_signals    INT NOT NULL DEFAULT 0,  -- per worker/job_type
    total_retracted_signals INT NOT NULL DEFAULT 0,  -- per worker/job_type
    net_signals             INT NOT NULL DEFAULT 0,  -- active - retracted
    
    -- When this row was last updated by materialization
    materialized_at  TIMESTAMPTZ NOT NULL
);

CREATE INDEX idx_signal_state_worker_job ON signal_current_state (worker_id, job_type_id, status);
CREATE INDEX idx_signal_state_materialized ON signal_current_state (materialized_at);


-- ═══════════════════════════════════════════════════════════════
-- 3. TRAINING SNAPSHOTS — Point-in-time extracts for model training.
--    These are IMMUTABLE once written. They capture the state of
--    signals as of a specific point in time, so model training
--    doesn't need to worry about retractions that happen later.
-- ═══════════════════════════════════════════════════════════════

CREATE TABLE training_snapshots (
    snapshot_id      TEXT NOT NULL PRIMARY KEY,
    snapshot_at      TIMESTAMPTZ NOT NULL,  -- The point-in-time cutoff
    worker_id        TEXT NOT NULL,
    job_type_id      TEXT NOT NULL,
    
    -- The signal state AS OF snapshot_at.
    -- Only includes signals that were active at that time.
    -- A signal is "active at time T" if:
    --   - Its emission event has log_seq <= T's log_seq
    --   - AND it has no retraction event with log_seq <= T's log_seq
    active_count    INT NOT NULL,
    retracted_count INT NOT NULL,
    net_count       INT NOT NULL,
    
    -- The individual signal IDs that were active, for traceability
    active_signal_ids  TEXT[] NOT NULL,
    
    created_at       TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_training_snapshots_worker_job ON training_snapshots (worker_id, job_type_id, snapshot_at);
CREATE INDEX idx_training_snapshots_at ON training_snapshots (snapshot_at);


-- ═══════════════════════════════════════════════════════════════
-- 4. RECONCILIATION LOG — Audit trail of reconciliation runs.
--    Every time we compare the materialized view to the event log,
--    we record what we found and what we fixed.
-- ═══════════════════════════════════════════════════════════════

CREATE TABLE reconciliation_log (
    run_id           TEXT NOT NULL PRIMARY KEY,
    started_at       TIMESTAMPTZ NOT NULL,
    completed_at     TIMESTAMPTZ,
    
    -- What we checked
    total_signals_checked  INT NOT NULL,
    mismatches_found       INT NOT NULL,
    mismatches_fixed       INT NOT NULL,
    
    -- Details of mismatches (for debugging)
    mismatch_details JSONB,
    
    -- The log sequence up to which we reconciled
    reconciled_up_to_seq   BIGINT NOT NULL,
    
    -- Outcome
    status           TEXT NOT NULL CHECK (status IN ('success', 'partial', 'failed'))
);
