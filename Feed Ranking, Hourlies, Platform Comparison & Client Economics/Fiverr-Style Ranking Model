"""
Fiverr-style search ranking — a two-stage funnel model.
Ranks gigs by expected revenue per impression.

Stage 1: P(click | impression) — CTR model
Stage 2: P(order | click) — conversion model
Combined: E[revenue] = CTR × CVR × AOV × take_rate
"""
from __future__ import annotations
import numpy as np
from dataclasses import dataclass, field
from typing import Optional


@dataclass
class Seller:
    id: str
    level: int                     # 0=New, 1=Level 1, 2=Level 2, 3=Top Rated, 4=Pro
    order_completion_rate: float   # 0-1
    on_time_rate: float            # 0-1
    response_rate: float           # 0-1
    response_time_minutes: float
    total_orders: int
    account_age_days: int
    warnings: int                  # TOS violations


@dataclass
class Gig:
    id: str
    seller: Seller
    title: str
    tags: list[str]
    base_price: float              # starting price in USD
    avg_order_value: float         # actual average order including upsells
    review_count: int
    avg_rating: float              # 1-5
    review_velocity_30d: int       # reviews in last 30 days
    ctr_7d: float                  # click-through rate in last 7 days
    ctr_30d: float
    cvr_7d: float                  # conversion rate (view→order) last 7 days
    cvr_30d: float
    gig_age_days: int
    last_order_days_ago: int
    image_quality_score: float     # 0-1, from a CV model on thumbnail
    video_present: bool
    mobile_friendly: bool
    promoted: bool = False         # using Promoted Gigs (paid)


@dataclass
class SearchQuery:
    query: str
    buyer_geo: str                 # "US", "UK", "IN", etc.
    buyer_historical_category: Optional[str] = None
    competition_level: float = 0.5  # 0-1, how many gigs match this query


# -------------------- CTR model --------------------
def predict_ctr(gig: Gig, query: SearchQuery) -> float:
    """
    Predicts P(click | impression).
    Simplified model — production Fiverr uses gradient-boosted trees with ~50 features.
    """
    # Base CTR from recent performance (weighted 70% last 7d, 30% last 30d)
    base_ctr = 0.7 * gig.ctr_7d + 0.3 * gig.ctr_30d

    # Image quality boost (thumbnails drive clicks heavily)
    image_effect = 0.5 * gig.image_quality_score
    if gig.video_present:
        image_effect += 0.1

    # Seller level boost
    level_boost = [0.0, 0.02, 0.04, 0.08, 0.12][min(gig.seller.level, 4)]

    # Review count effect (logarithmic — diminishing returns)
    review_effect = 0.03 * np.log1p(gig.review_count) / np.log(1 + 500)

    # Freshness (new gigs get a testing boost)
    if gig.gig_age_days <= 14:
        freshness_boost = 0.05
    elif gig.gig_age_days <= 30:
        freshness_boost = 0.02
    else:
        freshness_boost = 0.0

    # Staleness penalty (no recent orders → looks abandoned)
    staleness = max(0.0, (gig.last_order_days_ago - 14) / 60.0 * 0.3)

    # Keyword match (simplified — production uses embeddings)
    query_words = set(query.query.lower().split())
    tag_words = set(t.lower() for t in gig.tags)
    title_words = set(gig.title.lower().split())
    keyword_match = (
        len(query_words & tag_words) / max(len(query_words), 1) * 0.6
        + len(query_words & title_words) / max(len(query_words), 1) * 0.4
    )

    ctr = (
        base_ctr * 0.40
        + image_effect * 0.20
        + level_boost * 1.0
        + review_effect * 1.0
        + freshness_boost
        + keyword_match * 0.25
        - staleness
    )

    return float(np.clip(ctr, 0.005, 0.30))  # realistic CTR range


# -------------------- Conversion model --------------------
def predict_cvr(gig: Gig, query: SearchQuery) -> float:
    """
    Predicts P(order | click).
    """
    base_cvr = 0.7 * gig.cvr_7d + 0.3 * gig.cvr_30d

    # Rating effect (Bayesian-shrunk)
    prior_n = 5
    shrunk_rating = (prior_n * 4.5 + gig.review_count * gig.avg_rating) / (prior_n + gig.review_count)
    rating_effect = (shrunk_rating - 4.0) / 1.0 * 0.05  # ±5% per rating point

    # Price competitiveness (relative to category average, ~$80 for most categories)
    category_avg_price = 80.0
    price_ratio = gig.base_price / category_avg_price
    if price_ratio < 0.5:
        price_effect = 0.08  # cheap → higher conversion
    elif price_ratio < 1.0:
        price_effect = 0.03
    elif price_ratio < 2.0:
        price_effect = -0.02
    else:
        price_effect = -0.06  # expensive → lower conversion

    # Review count social proof (logarithmic)
    social_proof = 0.04 * np.log1p(gig.review_count) / np.log(1 + 300)

    # Response time effect (fast responses convert better)
    if gig.seller.response_time_minutes < 60:
        response_effect = 0.03
    elif gig.seller.response_time_minutes < 240:
        response_effect = 0.01
    else:
        response_effect = -0.03

    # Seller quality signals
    completion_effect = (gig.seller.order_completion_rate - 0.90) * 0.3
    ontime_effect = (gig.seller.on_time_rate - 0.90) * 0.2
    warning_penalty = gig.seller.warnings * 0.05

    cvr = (
        base_cvr * 0.50
        + rating_effect
        + price_effect
        + social_proof
        + response_effect
        + completion_effect
        + ontime_effect
        - warning_penalty
    )

    return float(np.clip(cvr, 0.005, 0.25))  # realistic CVR range


# -------------------- the ranker --------------------
FIVERR_TAKE_RATE = 0.20


def rank_gigs(gigs: list[Gig], query: SearchQuery, n_results: int = 20) -> list[dict]:
    """
    Ranks gigs by expected Fiverr revenue per impression.
    Also computes the component breakdown for each gig.
    """
    results = []
    for gig in gigs:
        ctr = predict_ctr(gig, query)
        cvr = predict_cvr(gig, query)
        aov = gig.avg_order_value
        expected_revenue = ctr * cvr * aov * FIVERR_TAKE_RATE

        # Promoted Gigs boost (paid placement, always shown above organic)
        promoted_boost = 1.5 if gig.promoted else 1.0

        results.append({
            "gig": gig,
            "ctr": ctr,
            "cvr": cvr,
            "aov": aov,
            "expected_revenue": expected_revenue,
            "final_score": expected_revenue * promoted_boost,
            "promoted": gig.promoted,
        })

    # Promoted gigs first, then organic by score
    results.sort(key=lambda r: (r["promoted"], r["final_score"]), reverse=True)
    return results[:n_results]


