"""
Optimal allocation of freelancer time between Offerstream proposals
and Hourlies. Models both as asset classes with different risk/return.

Key insight: Hourlies are a high-fixed-cost, low-marginal-cost asset
(list once, sell many times). Offerstream is a low-fixed-cost, high-marginal-cost
asset (write each proposal from scratch). The optimal mix depends on
the freelancer's time horizon and risk aversion.
"""
from __future__ import annotations
import numpy as np
from dataclasses import dataclass, field
from typing import Optional


@dataclass
class HourlieSpec:
    """A productized gig listing."""
    title: str
    price_gbp: float
    setup_hours: float                  # time to create listing, write copy, portfolio
    maintenance_hours_per_week: float   # responding to messages, fulfilling orders
    expected_conv_rate: float           # P(buy | view) — depends on ranking
    expected_views_per_week: float      # depends on search ranking
    days_since_last_sale: int = 0       # for staleness penalty
    current_reviews: int = 0
    current_rating: float = 0.0


@dataclass
class OfferstreamOpportunity:
    """A custom-proposal job in the feed."""
    job_id: str
    revenue_if_won: float
    win_rate: float                     # P(win | apply, no boost)
    win_rate_with_boost: float
    time_per_proposal_hours: float
    credits_required: int
    boost_credits: int


@dataclass
class FreelancerCapacity:
    hours_per_week: float = 40
    credit_balance: int = 150           # monthly Pro allowance
    risk_aversion: float = 0.5          # 0=risk-neutral, 1=very risk-averse


def hourlie_weekly_revenue(h: HourlieSpec) -> dict:
    """Expected weekly revenue and time cost for an Hourlie."""
    # Staleness penalty: if no sale in 30+ days, conv rate decays
    staleness_factor = max(0.3, 1.0 - max(0, h.days_since_last_sale - 14) / 60.0)
    effective_conv = h.expected_conv_rate * staleness_factor

    expected_sales = h.expected_views_per_week * effective_conv
    expected_revenue = expected_sales * h.price_gbp
    weekly_time = h.maintenance_hours_per_week

    # After first sale, conv rate typically improves (social proof)
    # We model this stochastically
    return {
        "expected_sales": expected_sales,
        "expected_revenue": expected_revenue,
        "weekly_time_hours": weekly_time,
        "revenue_per_hour": expected_revenue / max(weekly_time, 0.1),
    }


def offerstream_ev(opp: OfferstreamOpportunity, credit_value: float = 0.08) -> dict:
    """EV of submitting one proposal (no boost)."""
    credit_cost = opp.credits_required * credit_value
    ev = opp.win_rate * opp.revenue_if_won - credit_cost
    return {
        "ev": ev,
        "credit_cost": credit_cost,
        "expected_revenue": opp.win_rate * opp.revenue_if_won,
        "expected_time_hours": opp.time_per_proposal_hours,
        "revenue_per_hour": ev / max(opp.time_per_proposal_hours, 0.1),
    }


def portfolio_optimization(
    hourlies: list[HourlieSpec],
    opportunities: list[OfferstreamOpportunity],
    capacity: FreelancerCapacity,
) -> dict:
    """
    Greedy portfolio: rank both asset classes by revenue/hour.
    Allocate capacity hour-by-hour to the best option.
    """
    # Score each Hourlie
    hourlie_scores = []
    for i, h in enumerate(hourlies):
        rev = hourlie_weekly_revenue(h)
        hourlie_scores.append({
            "type": "hourlie",
            "index": i,
            "title": h.title,
            "revenue_per_hour": rev["revenue_per_hour"],
            "expected_weekly_revenue": rev["expected_revenue"],
            "weekly_time": rev["weekly_time_hours"],
            "setup_hours": h.setup_hours,
        })

    # Score each Offerstream opportunity
    opp_scores = []
    for i, opp in enumerate(opportunities):
        ev = offerstream_ev(opp)
        opp_scores.append({
            "type": "offerstream",
            "index": i,
            "job_id": opp.job_id,
            "revenue_per_hour": ev["revenue_per_hour"],
            "ev": ev["ev"],
            "time": ev["expected_time_hours"],
            "credits": opp.credits_required,
        })

    # Allocate
    remaining_hours = capacity.hours_per_week
    remaining_credits = capacity.credit_balance
    total_revenue = 0.0
    allocation = {"hourlies": [], "offers": [], "skipped": []}

    # First: setup Hourlies (high fixed cost but high long-term payoff)
    # Sort by expected weekly revenue / setup hours
    hourlie_scores.sort(
        key=lambda h: h["expected_weekly_revenue"] / max(h["setup_hours"], 0.1),
        reverse=True,
    )
    for h in hourlie_scores:
        if remaining_hours >= h["setup_hours"]:
            allocation["hourlies"].append({
                "title": h["title"],
                "setup_hours": h["setup_hours"],
                "expected_weekly_revenue": h["expected_weekly_revenue"],
                "weekly_maintenance_hours": h["weekly_time"],
            })
            remaining_hours -= h["setup_hours"]
            total_revenue += h["expected_weekly_revenue"]  # first week revenue
        else:
            allocation["skipped"].append({"type": "hourlie", "title": h["title"]})

    # Subtract Hourlie maintenance from remaining hours
    weekly_maintenance = sum(h["weekly_time"] for h in hourlie_scores
                             if any(a["title"] == h["title"] for a in allocation["hourlies"]))
    remaining_hours -= weekly_maintenance

    # Then: allocate remaining hours to best Offerstream opportunities
    opp_scores.sort(key=lambda o: o["revenue_per_hour"], reverse=True)
    for o in opp_scores:
        if remaining_hours < o["time"]:
            break
        if remaining_credits < o["credits"]:
            continue
        allocation["offers"].append({
            "job_id": o["job_id"],
            "ev": o["ev"],
            "time_hours": o["time"],
            "credits": o["credits"],
        })
        remaining_hours -= o["time"]
        remaining_credits -= o["credits"]
        total_revenue += o["ev"]

    return {
        "allocation": allocation,
        "weekly_revenue_estimate": total_revenue,
        "remaining_hours": remaining_hours,
        "remaining_credits": remaining_credits,
    }


