if __name__ == "__main__":
    now = datetime(2025, 1, 15, 14, 0)

    alice = Freelancer(
        id="alice", 
        skills={"wordpress": 0.9, "shopify": 0.85, "css": 0.95, "react": 0.7, "seo": 0.6},
        categories={"web-development": 0.18, "ecommerce": 0.22, "design": 0.05},
        hourly_rate_gbp=75, geography="GBR", languages={"en"},
        subscription_tier="pro", earnings_tier=4, response_rate=0.96,
        avg_rating=4.9, num_completed_jobs=187,
    )

    # Pro subscriber sees ALL jobs immediately
    # Free subscriber sees only jobs older than 24h
    alice_free = Freelancer(**{**alice.__dict__, "subscription_tier": "free"})

    # Generate 200 random jobs
    import random
    random.seed(42)
    jobs = []
    for i in range(200):
        cat = random.choice(["web-development", "ecommerce", "design", "writing", "marketing"])
        age_hours = random.uniform(0.1, 240)
        client = Client(
            id=f"c-{i}",
            avg_rating=random.uniform(3.0, 5.0),
            num_jobs_posted=random.randint(0, 50),
            total_spent_gbp=random.uniform(0, 50000),
            payment_verified=random.random() > 0.3,
            repeat_hire_rate=random.uniform(0, 0.5),
        )
        job = Job(
            id=f"job-{i:03d}",
            posted_at=now - timedelta(hours=age_hours),
            category=cat,
            required_skills={
                s: random.uniform(0.5, 0.9)
                for s in random.sample(["wordpress","shopify","css","react","seo","copywriting","figma"],
                                       k=random.randint(1, 3))
            },
            budget_gbp=random.choice([100, 300, 800, 1500, 3000, 6000]),
            budget_type="fixed",
            geography_restriction=random.choice([None, None, None, "GBR", "EU"]),
            language_required="en",
            num_existing_proposals=random.randint(0, 25),
            client=client,
            title=f"Job {i}",
            description_length=random.randint(50, 800),
        )
        jobs.append(job)

    # Compare Pro vs Free
    print("=" * 70)
    print("ALICE (Pro subscriber) — feed ranking, top 10")
    print("=" * 70)
    feed_pro = rank_feed(jobs, alice, now, page_size=10)
    print(f"{'Rank':<6}{'Job':<10}{'Category':<18}{'Budget':>8}{'Age(h)':>8}{'Proposals':>11}{'Score':>8}")
    print("-" * 75)
    for i, (job, score) in enumerate(feed_pro, 1):
        age_h = (now - job.posted_at).total_seconds() / 3600
        print(f"{i:<6}{job.id:<10}{job.category:<18}£{job.budget_gbp:>6.0f}{age_h:>8.1f}"
              f"{job.num_existing_proposals:>11}{score:>8.3f}")

    print(f"\nTotal jobs visible to Pro Alice: {len([j for j in jobs if passes_hard_filters(j, alice)[0] and is_visible_to_tier(j, alice, now)])}")
    print(f"Total jobs visible to Free Alice: {len([j for j in jobs if passes_hard_filters(j, alice_free)[0] and is_visible_to_tier(j, alice_free, now)])}")

    # Quantify the Pro advantage: how many of the top 10 Pro jobs are invisible to Free?
    top_pro_ids = {j.id for j, _ in feed_pro}
    free_feed = rank_feed(jobs, alice_free, now, page_size=100)
    free_visible_ids = {j.id for j, _ in free_feed}
    invisible_to_free = top_pro_ids - free_visible_ids
    print(f"\nOf Pro Alice's top 10 jobs, {len(invisible_to_free)} are INVISIBLE to Free Alice (too fresh)")
