// sla-enforcer.ts

import { config } from './config';

interface SLAConfig {
  review: {
    queueWaitMs: number;       // Time to find a reviewer
    completionMs: number;      // Time for reviewer to decide
  };
  appealWindow: {
    durationMs: number;        // Time for worker to file appeal
  };
  appeal_review: {
    queueWaitMs: number;       // Time to find appellate reviewer
    completionMs: number;      // Time for appellate reviewer to decide
  };
}

class SLAEnforcer {
  private jobTypeOverrides: Map<string, Partial<SLAConfig>> = new Map();
  private maxAppealRates: Map<string, number> = new Map();
  
  constructor() {
    // Load job-type-specific SLA overrides from config
    // Some job types need faster review (real-time content moderation)
    // Some have longer appeal windows (complex judgment tasks)
    for (const [jobType, overrides] of Object.entries(config.sla.jobTypeOverrides)) {
      this.jobTypeOverrides.set(jobType, overrides);
    }
    for (const [jobType, rate] of Object.entries(config.sla.maxAppealRates)) {
      this.maxAppealRates.set(jobType, rate);
    }
  }
  
  getSLAForJobType(jobTypeId: string, stage: 'review' | 'appeal_review'): { durationMs: number } {
    const base = config.sla.defaults[stage];
    const override = this.jobTypeOverrides.get(jobTypeId)?.[stage];
    
    return {
      durationMs: override?.durationMs || base.durationMs,
    };
  }
  
  getAppealWindowForJobType(jobTypeId: string): { durationMs: number } {
    const base = config.sla.defaults.appealWindow;
    const override = this.jobTypeOverrides.get(jobTypeId)?.appealWindow;
    
    return {
      durationMs: override?.durationMs || base.durationMs,
    };
  }
  
  getMaxAppealRateForJobType(jobTypeId: string): number {
    return this.maxAppealRates.get(jobTypeId) || config.sla.defaults.maxAppealRate;
  }
}

