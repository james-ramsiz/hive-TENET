# docker-compose.yml — the whole platform on a laptop
version: "3.9"
services:
  kafka:
    image: bitnami/kafka:3.6
    environment:
      KAFKA_CFG_NODE_ID: 0
      KAFKA_CFG_PROCESS_ROLES: controller,broker
      KAFKA_CFG_CONTROLLER_QUORUM_VOTERS: 0@kafka:9093
      KAFKA_CFG_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093
      KAFKA_CFG_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CFG_AUTO_CREATE_TOPICS_ENABLE: "true"
    ports: ["9092:9092"]

  redis:
    image: redis:7-alpine
    command: redis-server --appendonly yes
    ports: ["6379:6379"]

  postgres:
    image: postgres:16
    environment: { POSTGRES_PASSWORD: dev, POSTGRES_DB: microgig }
    ports: ["5432:5432"]

  # ONE service that does everything for now (see Phase 1)
  app:
    build: ./services/monolith
    depends_on: [kafka, redis, postgres]
    environment:
      KAFKA: kafka:9092
      REDIS_URL: redis://redis:6379
      DATABASE_URL: postgres://postgres:dev@postgres/microgig
    ports: ["8080:8080"]
