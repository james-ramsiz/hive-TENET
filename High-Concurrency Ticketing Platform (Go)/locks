-- ticketing-platform/scripts/lua/hold_seat.lua
-- KEYS[1] = inventory:section_A (Hash Map)
-- ARGV[1] = seat_id
-- ARGV[2] = user_id
-- ARGV[3] = hold_ttl_seconds (e.g., 300)

local status = redis.call('HGET', KEYS[1], ARGV[1])

if status == 'AVAILABLE' or status == false or status == nil then
    -- Atomically hold the seat
    redis.call('HSET', KEYS[1], ARGV[1], 'HELD_BY_'..ARGV[2])
    redis.call('EXPIRE', KEYS[1], ARGV[3])
    return 1 -- Success
else
    return 0 -- Seat already taken
end
