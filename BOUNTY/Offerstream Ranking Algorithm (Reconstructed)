        category_match_score=0.9, repeat_client_rate=0.42,
        earnings_tier=4, is_pro_subscriber=True,
    )
    mid_freelancer = Freelancer(
        id="bob", rating=4.6, num_reviews=42, response_rate=0.82,
        avg_response_time_hours=6.0, profile_completeness=0.78,
        category_match_score=0.75, repeat_client_rate=0.25,
        earnings_tier=2, is_pro_subscriber=False,
    )
    new_freelancer = Freelancer(
        id="carol", rating=5.0, num_reviews=2, response_rate=0.7,
        avg_response_time_hours=12.0, profile_completeness=0.65,
        category_match_score=0.6, repeat_client_rate=0.0,
        earnings_tier=1, is_pro_subscriber=False,
    )

    proposals = [
        Proposal(id="p1", freelancer=pro_high, cover_letter="…", proposed_price=1400,
                 proposed_timeline_days=14, submitted_at=now - timedelta(minutes=30),
                 boost_tier=BoostTier.NONE, portfolio_items_attached=3,
                 has_questions_for_client=True, word_count=280),
        Proposal(id="p2", freelancer=mid_freelancer, cover_letter="…", proposed_price=1200,
