    print(f"Recency:        {15.0 * recency_score(top.submitted_at, now):.1f}")
    print(f"Price comp:     {12.0 * price_competitiveness_score(top.proposed_price, job.client_budget):.1f}")
    print(f"Response qual:  {8.0 * response_quality_score(top):.1f}")
