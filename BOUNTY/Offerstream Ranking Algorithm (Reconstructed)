                 boost_tier=BoostTier.STANDARD, portfolio_items_attached=1,
                 has_questions_for_client=True, word_count=180),
    ]

    ranked = sorted(proposals, key=lambda p: rank_proposal(p, job, now), reverse=True)
    print(f"{'Rank':<6}{'Proposal':<10}{'Freelancer':<14}{'Boost':<10}{'Price':<8}{'Score':<8}")
    print("-" * 60)
    for i, p in enumerate(ranked, 1):
        s = rank_proposal(p, job, now)
        print(f"{i:<6}{p.id:<10}{p.freelancer.id:<14}"
