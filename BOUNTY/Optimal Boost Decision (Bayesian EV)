if __name__ == "__main__":
    tiers = [
        BoostTier("none",     0,  1, 24),
        BoostTier("standard", 15, 3, 27),
        BoostTier("premium",  30, 8, 36),
    ]

    # Scenario 1: High-value web design job, mid-tier freelancer
    print("=" * 80)
    print("SCENARIO 1: £1,500 web design job, freelancer has £2,000 prior earnings")
    print("=" * 80)
    history = FreelancerHistory()
    best = best_boost_decision(
        tiers=tiers,
        proposed_revenue=1500.0,
        prior_earnings=2000.0,
        credit_value_gbp=0.08,    # Pro subscriber effective cost
        base_credits=15,
        time_cost_gbp=25.0,       # 30 min at £50/hr
        history=history,
    )
    print(f"\n→ Best tier: {best[0].name.upper()}  (EV = £{best[1]['ev_mean']:.2f})")

    # Scenario 2: Low-value job — boost math flips
    print("\n" + "=" * 80)
    print("SCENARIO 2: £150 small job, same freelancer")
    print("=" * 80)
    best = best_boost_decision(
        tiers=tiers,
        proposed_revenue=150.0,
        prior_earnings=2000.0,
        credit_value_gbp=0.08,
        base_credits=15,
        time_cost_gbp=10.0,       # less time spent
        history=history,
    )
    print(f"\n→ Best tier: {best[0].name.upper()}  (EV = £{best[1]['ev_mean']:.2f})")
