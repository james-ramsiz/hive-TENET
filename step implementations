async def update_model(ctx: StepContext) -> None:
    log.info("Triggering Model Service to swap active model for job %s to version %s", ctx.job_type_id, ctx.new_version_id)
    # If this fails (e.g. model accuracy is below threshold), it raises an exception,
    # which triggers the orchestrator's rollback.

async def undo_update_model(ctx: StepContext) -> None:
    log.info("Reverting Model Service to old model version %s (rollback)", ctx.old_version_id)

async def supersede_examples(ctx: StepContext) -> None:
    log.info("Calling Example Store to supersede examples for job %s", ctx.job_type_id)
