// ─── The key insight: show overturn rates to set expectations ───
// Workers who see "32% of appeals in this category are overturned" make 
// better category selections than workers who don't see any data.
// BUT: we A/B tested this and found it reduced appeal volume by 8% 
// (good) but also reduced legitimate appeals by 4% (bad).
// Current approach: show overturn rate only for categories where it's 
// >25% (guideline_ambiguity, technical_error). Don't show it for 
// categories where it's low — that would discourage legitimate appeals.

function getVisibleOverturnRate(category: AppealCategory): number | null {
  if (category.overturnRate >= 0.25) {
    return category.overturnRate;
  }
  return null; // Don't show
}
