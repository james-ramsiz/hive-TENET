// appeal-form-config.ts

interface AppealCategory {
  id: string;
  label: string;
  description: string;          // Shown below the label
  placeholder: string;          // Shown in the freeform field when this category is selected
  maxFreeformChars: number;     // Category-specific character limit
  requiresEvidence: boolean;    // If true, show an "attach screenshot" button
  // Prevalence tracking — how often this category is used and how often it wins
  usageCount: number;           // Updated daily
  overturnRate: number;         // What % of appeals in this category are overturned
}

