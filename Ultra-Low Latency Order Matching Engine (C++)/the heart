// matching-engine/include/disruptor/RingBuffer.h
#pragma once
#include <atomic>
#include <array>
#include <cstdint>

constexpr size_t BUFFER_SIZE = 1048576; // 2^20 (Must be power of 2 for fast modulo bitwise AND)
constexpr size_t RING_BUFFER_MASK = BUFFER_SIZE - 1;

// Cache-line padding to prevent False Sharing
struct alignas(64) PaddedAtomic {
    std::atomic<int64_t> sequence{0};
    char padding[64 - sizeof(std::atomic<int64_t>)];
};

template<typename T>
class RingBuffer {
public:
    RingBuffer() {
        // Pre-allocate memory to avoid runtime allocation (GC/Jitter)
        for (size_t i = 0; i < BUFFER_SIZE; ++i) {
            buffer_[i].sequence.store(i);
        }
    }

    // Producer calls this to publish data
    void publish(const T& event) {
        const int64_t seq = publisher_cursor.sequence.fetch_add(1);
        auto& slot = buffer_[seq & RING_BUFFER_MASK];
        
        // Busy-wait (spinlock) until the slot is free
        while (slot.sequence.load(std::memory_order_acquire) != seq) {
            // _mm_pause(); // x86 pause instruction to reduce power consumption during spin
        }
        
        slot.data = event;
        slot.sequence.store(seq + 1, std::memory_order_release);
    }

    // Consumer calls this to read data
    bool consume(int64_t& consumer_seq, T& out_event) {
        const int64_t seq = consumer_seq + 1;
        auto& slot = buffer_[seq & RING_BUFFER_MASK];
        
        // Check if data is ready
        if (slot.sequence.load(std::memory_order_acquire) != seq) {
            return false; // No new data
        }
        
        out_event = slot.data;
        consumer_seq = seq;
        return true;
    }

private:
    struct alignas(64) Slot {
        std::atomic<int64_t> sequence;
        T data;
    };
    
    std::array<Slot, BUFFER_SIZE> buffer_;
    PaddedAtomic publisher_cursor;   // Written by Network Thread
    PaddedAtomic consumer_cursor;    // Written by Matching Thread
};
