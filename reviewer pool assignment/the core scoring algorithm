# assignment/scorer.py
from __future__ import annotations
import math
from datetime import datetime, timezone
from .domain import ReviewerProfile, QueuedReview, ReviewerState
from .config import AssignmentConfig

class ReviewScorer:
    def __init__(self, cfg: AssignmentConfig):
        self._cfg = cfg

    def score(self, review: QueuedReview, reviewer: ReviewerProfile, state: ReviewerState) -> float:
        # --- HARD CONSTRAINTS (Return 0 immediately if violated) ---
        
        # 1. Fatigue Guard
        if reviewer.daily_review_limit > 0:
            fatigue_pct = state.fatigue_count / reviewer.daily_review_limit
            if fatigue_pct >= self._cfg.fatigue_threshold_pct:
                return 0.0

        # 2. Relationship Bias Guard
        if state.worker_exposure_count >= self._cfg.max_worker_exposure_7d:
            return 0.0

        # 3. Skill / Seniority Guard
        if review.is_appeal and reviewer.seniority_level < 3:
            return 0.0  # Only seniors handle appeals

        # --- SOFT CONSTRAINTS (Calculate continuous score) ---
        
        # 1. Base Score: Queue Age (Exponential decay based on time waiting)
        # A review waiting 1 hour gets a massive boost over one waiting 1 minute.
        age_seconds = (datetime.now(timezone.utc) - review.enqueued_at).total_seconds()
        # Score decays from base_age_score downwards as age approaches 0
        age_score = self._cfg.base_age_score * (1 - math.exp(-self._cfg.queue_age_lambda * (age_seconds / 60)))
        
        # 2. Difficulty Match Penalty
        # We want to match high difficulty reviews with high quality reviewers.
        # If difficulty is 0.9 but reviewer quality is 0.2, apply a penalty.
        difficulty_mismatch = abs(review.difficulty_score - reviewer.quality_score)
        difficulty_penalty = difficulty_mismatch * self._cfg.difficulty_match_weight * self._cfg.base_age_score
        
        # 3. Relationship Bias Penalty (Soft)
        # Even if under the hard limit (e.g., 2/5 exposures), apply a scaling penalty
        # so the algorithm prefers fresh worker/reviewer pairings.
        exposure_penalty = (state.worker_exposure_count / self._cfg.max_worker_exposure_7d) * self._cfg.bias_penalty_weight * 10.0

        final_score = age_score - difficulty_penalty - exposure_penalty
        return max(0.0, final_score)
