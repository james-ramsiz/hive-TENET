CREATE TABLE job_ratings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    job_id UUID NOT NULL REFERENCES jobs(id),
    reviewer_id UUID NOT NULL,
    reviewee_id UUID NOT NULL,
    reviewer_role VARCHAR(20) NOT NULL CHECK (reviewer_role IN ('CLIENT', 'PROFESSIONAL')),
    rating_value INT NOT NULL CHECK (rating_value BETWEEN 1 AND 5),
    review_text TEXT,
    status VARCHAR(20) NOT NULL DEFAULT 'BLIND' CHECK (status IN ('BLIND', 'PUBLISHED', 'DISPUTED')),
    created_at TIMESTAMPTZ DEFAULT NOW(),
    published_at TIMESTAMPTZ,
    UNIQUE(job_id, reviewer_role)
);

CREATE TABLE user_reputation (
    user_id UUID PRIMARY KEY,
    role VARCHAR(20) NOT NULL,
    avg_score DECIMAL(3,2) DEFAULT 0.00,
    total_ratings INT DEFAULT 0,
    updated_at TIMESTAMPTZ DEFAULT NOW()
);
