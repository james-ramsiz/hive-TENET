# Database
DATABASE_URL=postgres://user:pass@host:5432/ratings
# Redis
REDIS_URL=redis://host:6379
# Kafka
KAFKA_BROKERS=kafka1:9092,kafka2:9092
KAFKA_RATING_TOPIC=ratings
# Business Logic Configs
RATING_BLIND_WINDOW_DAYS=14
CLIENT_BOOKING_RESTRICTION_THRESHOLD=3.5
PRO_SEARCH_DEPRIORITIZATION_THRESHOLD=3.0
# Feature Flags
ENABLE_REVIEW_DISPUTES=false
ENABLE_TOXICITY_FILTER=true
TOXICITY_API_KEY=<secret>
