# example_store/freshness/tracker.py
from __future__ import annotations
import asyncio
import logging
from dataclasses import dataclass
from datetime import datetime, timezone
from typing import Optional

from ..storage.repo import ExampleRepo

log = logging.getLogger(__name__)

@dataclass
class GuidelineChange:
    job_type_id: str
    old_version_id: str
    new_version_id: str
    effective_at: datetime
    severity: str   # "minor" | "major"

class FreshnessTracker:
    """
    When a guideline changes:
      1. Insert the new guideline_version row.
      2. If severity == "major": mark all examples under the old version superseded
         (they stay queryable for the fallback path but excluded from default retrieval).
      3. If severity == "minor": keep examples, but tag them so reviewers see a "may reflect
         older guidelines" hint.
      4. Emit a re-labeling task — a sample of old examples is re-reviewed under the new
         rules to bootstrap the new version's pool.
    """
    def __init__(self, repo: ExampleRepo, pool, relabel_queue):
        self._repo = repo
        self._pool = pool
        self._relabel_queue = relabel_queue

    async def apply_change(self, change: GuidelineChange) -> dict:
        async with self._pool.acquire() as conn:
            await conn.execute(
                """
                INSERT INTO guideline_versions (id, job_type_id, version_label, effective_at, checksum)
                VALUES ($1, $2, $3, $4, $5)
                ON CONFLICT (id) DO NOTHING
                """,
                change.new_version_id, change.job_type_id,
                change.new_version_id, change.effective_at, hashlib.sha256(b"").hexdigest(),
            )

            await conn.execute(
                "UPDATE guideline_versions SET superseded_at=$2 WHERE id=$1",
                change.old_version_id, change.effective_at,
            )

            if change.severity == "major":
                rows = await conn.fetch(
                    """
                    WITH marked AS (
                        UPDATE examples SET is_superseded=true
                        WHERE job_type_id=$1 AND guideline_version_id=$2 AND is_superseded=false
                        RETURNING id, review_id
                    )
                    SELECT id, review_id FROM marked
                    """,
                    change.job_type_id, change.old_version_id,
                )
                log.info("superseded %d examples for job=%s old=%s",
                          len(rows), change.job_type_id, change.old_version_id)

                # Enqueue a sampling for re-labeling under new rules.
                for r in rows[:200]:
                    await self._relabel_queue.put({
                        "example_id": r["id"],
                        "review_id": str(r["review_id"]),
                        "new_guideline_version_id": change.new_version_id,
                        "job_type_id": change.job_type_id,
                    })

                return {"superseded_count": len(rows), "relabel_enqueued": min(len(rows), 200)}
            return {"superseded_count": 0, "relabel_enqueued": 0}
