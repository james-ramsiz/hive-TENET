# phase4/experiment_router.py
from __future__ import annotations
import hashlib
import logging
from dataclasses import dataclass
from typing import Optional
import asyncpg

log = logging.getLogger(__name__)

@dataclass(frozen=True)
class ExperimentConfig:
    id: str
    control_implementation: str
    treatment_implementation: str
    traffic_split: int

class ExperimentRouter:
    def __init__(self, pool: asyncpg.Pool):
        self._pool = pool
        self._cache: dict[str, ExperimentConfig] = {}

    async def load_experiments(self):
        async with self._pool.acquire() as conn:
            rows = await conn.fetch("SELECT id, control_implementation, treatment_implementation, traffic_split FROM experiments WHERE is_active = true")
            for r in rows:
                self._cache[r['id']] = ExperimentConfig(r['id'], r['control_implementation'], r['treatment_implementation'], r['traffic_split'])
        log.info("Loaded %d active experiments", len(self._cache))

    def get_variant(self, experiment_id: str, entity_id: str) -> str:
        """
        Returns the implementation name to use.
        """
        exp = self._cache.get(experiment_id)
        if not exp:
            return "default" # Fallback if experiment not found

        # Deterministic hash 0-99
        hash_input = f"{experiment_id}:{entity_id}".encode('utf-8')
        bucket = int(hashlib.md5(hash_input).hexdigest(), 16) % 100

        if bucket < exp.traffic_split:
            return exp.treatment_implementation
        return exp.control_implementation
