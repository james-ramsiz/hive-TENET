  {
    name: 'q.reviewer.perf',
    durable: true,
    autoDelete: false,
    exclusive: false,
    messageTtlMs: 30 * 24 * 60 * 60 * 1000, // 30 days — reviewer stats have a long window
    maxLength: 500_000,
    dlx: 'task.events.dlx',
    prefetchCount: 50,
  },
  
  // ─── Audit log ───
  // Consumed by: audit service
  // Events: ALL transitions
  {
    name: 'q.audit.log',
    durable: true,
    autoDelete: false,
    exclusive: false,
    messageTtlMs: 90 * 24 * 60 * 60 * 1000, // 90 days — compliance requirement
    maxLength: 1_000_000,
    dlx: 'task.events.dlx',
    prefetchCount: 20,                // Audit is low priority
  },
  
  // ─── Catch-all for debugging ───
  // Consumed by: dev tools, replay service
