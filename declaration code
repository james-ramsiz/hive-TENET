// queue-topology.ts
// This file is the SINGLE SOURCE OF TRUTH for the entire queue topology.
// Every service imports this. No service declares its own queues.
// This is loaded once at service startup and asserted against the broker.

import amqplib, { Connection, Channel } from 'amqplib';

// ─── Types ───

interface ExchangeDef {
  name: string;
  type: 'direct' | 'topic' | 'fanout' | 'headers';
  durable: boolean;
  autoDelete: boolean;
}

interface QueueDef {
  name: string;
  durable: boolean;
  autoDelete: boolean;
  exclusive: boolean;
  // Message TTL — messages older than this are dropped
  messageTtlMs?: number;
  // Max length — queue drops oldest messages when full
  maxLength?: number;
  // Dead letter exchange — where failed messages go
  dlx?: string;
  // Dead letter routing key — what key to use when forwarding to DLX
  dlxRoutingKey?: string;
  // Per-consumer prefetch — how many unacked messages a consumer can hold
  prefetchCount: number;
  // Priority queue support
  maxPriority?: number;
}

interface BindingDef {
  queue: string;
  exchange: string;
  routingKeyPattern: string;  // * and # wildcards for topic exchanges
  // For priority routing: map routing key substrings to priority values
  priorityMap?: Array<{ pattern: string; priority: number }>;
}

// ─── The Topology ───

const EXCHANGES: ExchangeDef[] = [
  {
    name: 'task.events',
    type: 'topic',
    durable: true,
    autoDelete: false,
  },
  {
    name: 'task.events.dlx',
    type: 'fanout',
    durable: true,
    autoDelete: false,
  },
  // Separate exchange for control messages (SLA advances, flush signals)
  // that shouldn't mix with business events
  {
    name: 'task.control',
    type: 'direct',
    durable: true,
    autoDelete: false,
  },
  {
    name: 'task.control.dlx',
    type: 'fanout',
    durable: true,
    autoDelete: false,
  },
];

const QUEUES: QueueDef[] = [
