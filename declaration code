    durable: true,
    autoDelete: false,
    exclusive: false,
    messageTtlMs: 24 * 60 * 60 * 1000, // 24h — signals older than this are useless
    maxLength: 100_000,               // Drop oldest if queue is enormous
    dlx: 'task.events.dlx',
    prefetchCount: 50,                // Can process 50 signals in parallel
  },
  
  // ─── Appeal review assignment ───
