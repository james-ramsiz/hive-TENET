  {
    name: 'q.appeal.assignment',
    durable: true,
    autoDelete: false,
    exclusive: false,
    messageTtlMs: 48 * 60 * 60 * 1000, // 48h — appeals have longer windows
    dlx: 'task.events.dlx',
    prefetchCount: 10,                // Appeal assignment is slower — don't overload
    maxPriority: 5,                   // Overturned tasks generate priority appeals
  },
  
  // ─── Signal retraction ───
  // Consumed by: signal-event-log service (retraction handler)
  // Events: overturned
  {
    name: 'q.signal.retraction',
    durable: true,
    autoDelete: false,
    exclusive: false,
    messageTtlMs: 72 * 60 * 60 * 1000, // 72h — retractions are critical, don't lose them
    dlx: 'task.events.dlx',
