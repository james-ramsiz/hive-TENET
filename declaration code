const BINDINGS: BindingDef[] = [
  // Worker signal queue: all rejection events → emit performance signal
  { queue: 'q.worker.signal', exchange: 'task.events', routingKeyPattern: '*.rejected.*' },
  { queue: 'q.worker.signal', exchange: 'task.events', routingKeyPattern: '*.accepted.*' },
  
  // Appeal assignment queue: appealed events
  { queue: 'q.appeal.assignment', exchange: 'task.events', routingKeyPattern: '*.appealed.*' },
  { queue: 'q.appeal.assignment', exchange: 'task.events', routingKeyPattern: '*.queued_for_appeal.*' },
  
  // Signal retraction queue: overturn events
  { queue: 'q.signal.retraction', exchange: 'task.events', routingKeyPattern: '*.overturned.*' },
  
  // Reviewer performance: all decisions
  { queue: 'q.reviewer.perf', exchange: 'task.events', routingKeyPattern: '*.accepted.*' },
  { queue: 'q.reviewer.perf', exchange: 'task.events', routingKeyPattern: '*.rejected.*' },
  { queue: 'q.reviewer.perf', exchange: 'task.events', routingKeyPattern: '*.upheld.*' },
  { queue: 'q.reviewer.perf', exchange: 'task.events', routingKeyPattern: '*.overturned.*' },
  
  // Audit: everything
  { queue: 'q.audit.log', exchange: 'task.events', routingKeyPattern: '*.*.*' },
  
  // Catch-all: everything (for debugging/replay)
  { queue: 'q.catchall', exchange: 'task.events', routingKeyPattern: '#*' },
  
  // DLQ bindings: fanout exchange → all DLQs
  // (Each source queue's DLX is configured to route to its specific DLQ
  //  via the dlxRoutingKey setting on the queue itself, not via binding.
  //  The fanout DLX is a safety net for messages that don't match.)
];

// ─── Topology Assertion ───
// This function asserts that the broker's topology matches our declarations.
// If there's a mismatch, it THROWS — we'd rather fail to start than run
// with a wrong topology.

export async function assertTopology(channel: Channel): Promise<void> {
  // Assert exchanges
  for (const ex of EXCHANGES) {
    await channel.assertExchange(ex.name, ex.type, {
      durable: ex.durable,
      autoDelete: ex.autoDelete,
    });
  }
  
  // Assert queues
  const dlxQueueNames = new Set(QUEUES.filter(q => q.name.startsWith('dlq.')).map(q => q.name));
  
  for (const q of QUEUES) {
    const args: any = {};
    
    if (q.messageTtlMs) args['x-message-ttl'] = q.messageTtlMs;
    if (q.maxLength) args['x-max-length'] = q.maxLength;
    if (q.dlx && !dlxQueueNames.has(q.name)) {
      // Non-DLQ queues get a DLX configured
      args['x-dead-letter-exchange'] = q.dlx;
      // Use the queue name as the dead letter routing key so the DLX
      // can route to the correct DLQ
      args['x-dead-letter-routing-key'] = q.name;
    }
    if (q.maxPriority) args['x-max-priority'] = q.maxPriority;
    
    await channel.assertQueue(q.name, {
      durable: q.durable,
      autoDelete: q.autoDelete,
      exclusive: q.exclusive,
      arguments: args,
    });
  }
  
  // Assert bindings
  for (const b of BINDINGS) {
    await channel.bindQueue(b.queue, b.exchange, b.routingKeyPattern);
  }
  
  // Assert DLX → DLQ bindings
  // Each DLQ binds to its corresponding DLX with the source queue name as routing key
  for (const q of QUEUES) {
    if (q.dlx && !dlxQueueNames.has(q.name)) {
      const dlqName = `dlq.${q.name}`;
      await channel.bindQueue(dlqName, q.dlx, q.name);
    }
  }
}

export { EXCHANGES, QUEUES, BINDINGS };
export type { ExchangeDef, QueueDef, BindingDef };
