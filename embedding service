# example_store/embedding/encoder.py
from __future__ import annotations
import asyncio
import logging
import time
from dataclasses import dataclass
from typing import Iterable, Sequence

import torch

from ..domain import EmbeddingVector, Modality, ScrubbedSubmission
from ..config import EmbeddingConfig

log = logging.getLogger(__name__)

class EmbeddingEncoder:
    """
    Multimodal encoder. Text and image streams are encoded independently and
    projected into a shared 384-d space via learned projections (omitted here
    for brevity — replaced with a concatenation + linear projection).
    """
    def __init__(self, cfg: EmbeddingConfig, device: str | None = None) -> None:
        self.cfg = cfg
        self.device = device or ("cuda" if torch.cuda.is_available() else "cpu")
        self._lock = asyncio.Lock()
        self._text_model = None
        self._image_model = None
        self._text_proj = None
        self._image_proj = None

    async def load(self) -> None:
        # Lazy import so workers that don't need GPU don't pay the cost.
        from sentence_transformers import SentenceTransformer
        from transformers import CLIPModel, CLIPProcessor
        loop = asyncio.get_running_loop()
        self._text_model = await loop.run_in_executor(
            None, lambda: SentenceTransformer(self.cfg.text_model_path, device=self.device)
        )
        self._image_model = await loop.run_in_executor(
            None, lambda: CLIPModel.from_pretrained(self.cfg.image_model_path)
        )
        self._image_model.to(self.device)
        self._image_processor = CLIPProcessor.from_pretrained(self.cfg.image_model_path)

    async def encode_text(self, texts: Sequence[str]) -> list[EmbeddingVector]:
        if not texts:
            return []
        loop = asyncio.get_running_loop()
        async with self._lock:
            vecs = await loop.run_in_executor(None, self._encode_text_sync, texts)
        return [EmbeddingVector(
            model_id=self.cfg.text_model_id,
            dim=self.cfg.dim,
            vector=v.tolist(),
            embedded_text=t[:512],
        ) for v, t in zip(vecs, texts)]

    def _encode_text_sync(self, texts: Sequence[str]) -> torch.Tensor:
        with torch.no_grad():
            embs = self._text_model.encode(
                list(texts),
                batch_size=self.cfg.gpu_batch_size if self.device == "cuda" else self.cfg.cpu_batch_size,
                convert_to_numpy=False,
                normalize_embeddings=True,
                show_progress_bar=False,
            )
        # Project to target dim if needed
        if embs.shape[-1] != self.cfg.dim:
            embs = self._text_proj(embs)
        return embs.cpu()
