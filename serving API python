async def display(req: Request, example_uid: UUID) -> dict:
    """
    Display endpoint returns the *scrubbed display_payload* — never raw PII.
    Raw access requires a separate authenticated endpoint (not exposed here).
    """
    async with req.app.state.pool.acquire() as conn:
        row = await conn.fetchrow(
            "SELECT display_payload, label, guideline_version_id FROM examples WHERE example_uid=$1",
            example_uid,
        )
        if row is None:
            raise HTTPException(status_code=404, detail="not found")
        return {
            "display": row["display_payload"],
            "label": row["label"],
            "guideline_version_id": row["guideline_version_id"],
        }

async def health(req: Request) -> dict:
    return {"ok": True, "env": get_settings().environment}

async def metrics(req: Request) -> Response:
    from prometheus_client import generate_latest, CONTENT_TYPE_LATEST
    return Response(content=generate_latest(), media_type=CONTENT_TYPE_LATEST)
