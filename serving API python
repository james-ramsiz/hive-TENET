# example_store/api/handlers.py
from __future__ import annotations
import logging
from typing import Any
from uuid import UUID

from fastapi import Request, HTTPException
from pydantic import BaseModel, Field

from ..domain import Label, Modality, RetrievalRequest, Submission

log = logging.getLogger(__name__)

class RetrieveReq(BaseModel):
    job_type_id: str
    worker_id: str
    fields: dict[str, Any]
    modality: str = "text"
    guideline_version_id: str
    per_label: int = 4

class RetrieveResp(BaseModel):
    examples: list[dict]

async def retrieve(req: Request, body: RetrieveReq) -> dict:
    retriever = req.app.state.retriever
    sub = Submission(
        job_type_id=body.job_type_id,
        worker_id=body.worker_id,
        fields=body.fields,
        modality=Modality(body.modality),
    )
    request = RetrievalRequest(
        job_type_id=body.job_type_id,
        submission=sub,
        guideline_version_id=body.guideline_version_id,
        per_label=body.per_label,
    )
    results = await retriever.retrieve(request)
    return {"examples": [
        {
            "example_uid": str(r.example_uid),
            "label": r.label.value,
            "similarity": round(r.similarity, 4),
            "guideline_version_id": r.guideline_version_id,
            "is_cold_start_seed": r.is_cold_start_seed,
            "quality_score": r.quality_score,
            "display_key": r.example_uid,   # client fetches via /v1/examples/{uid}/display
        } for r in results
    ]}

